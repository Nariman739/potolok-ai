# Файлы-близнецы 3D: приложение (potolok-integration) → сайт (potolok-ai). Одна строка — одна пара:
#   <путь на сайте>  <путь в приложении>  [правило]
# правила: byte — побайтно (по умолчанию); nohdr — без строки «ФАЙЛ-БЛИЗНЕЦ» в шапке;
#          fiber-web — заменить "@react-three/fiber/native" на "@react-three/fiber".
# Читают scratchpad/parity/sync-from-app.sh (копия приложение → сайт) и twins.sh (сверка).
#
# данные (сайт src/lib ↔ приложение src/lib/shared)
src/lib/canvas-pricing.ts                     src/lib/shared/canvas-pricing.ts        nohdr
src/lib/wall-furniture.ts                     src/lib/shared/wall-furniture.ts
src/lib/room-remap.ts                        src/lib/shared/room-remap.ts
src/lib/furniture-ceiling.ts                  src/lib/shared/furniture-ceiling.ts
src/lib/spot-types.ts                         src/lib/shared/spot-types.ts
src/lib/shared/level2-geometry.ts             src/lib/shared/level2-geometry.ts
# 3D: баланс света (сайт src/lib/shared ↔ приложение room-3d)
src/lib/shared/lightBalance.ts                src/components/room-3d/lightBalance.ts
# 3D-модули (сайт src/components/room-3d ↔ приложение src/components/room-3d)
