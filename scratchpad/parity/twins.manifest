src/components/room-3d/WallFacade3D.tsx       src/components/room-3d/WallFacade3D.tsx
src/components/room-3d/ceilingBake.ts         src/components/room-3d/ceilingBake.ts
src/components/room-3d/wallBake.ts            src/components/room-3d/wallBake.ts
src/components/room-3d/chandelierLook.ts      src/components/room-3d/chandelierLook.ts
